# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
# Generate a strong secret for production.
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_VALUE
JWT_EXPIRES_IN=24h

# Encryption Key for API Keys (32+ characters for AES-256)
ENCRYPTION_KEY=CHANGE_ME_TO_32+_CHARS_MINIMUM

# Database
DATABASE_PATH=./storage/database.sqlite

# Storage Paths
DOCUMENTS_PATH=./storage/documents
EMBEDDINGS_PATH=./storage/embeddings

# LLM Provider API Keys (Optional - can be configured per agent)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# DASHSCOPE_API_KEY=  # (or QWEN_API_KEY)
KIMI_API_KEY=
MOONSHOT_API_KEY=
# Kimi/Moonshot Base URL (international: https://api.moonshot.ai/v1, China: https://api.moonshot.cn/v1)
KIMI_BASE_URL=https://api.moonshot.ai/v1

# OpenRouter (many models through one OpenAI-compatible endpoint). Model ids are author/slug.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_NAME=Badvisor

# Ollama Configuration (for local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b

# Decision model for Router mode (optional). Local Nimble uses the session host/port, or OLLAMA_BASE_URL.
# Remote Jev calls POST /v1/systemone. Leave the key empty to configure it per session instead.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# llama.cpp server (OpenAI-compatible /v1). One llama-server process usually serves one model.
# Tool calls need the server started with --jinja. API key is optional (only if the server uses --api-key).
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LLAMACPP_API_KEY=

# The email mailbox is set per agent in Configure Session → Tools, not here.
# EMAIL_POP3_POLL_MS=120000
# EMAIL_INBOUND_MAX_PER_HOUR=30

# Web Search Tool (optional)
BRAVE_SEARCH_API_KEY=

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100000

# Context controls
DEFAULT_MESSAGE_LIMIT_CONTEXT_LENGTH=10

# Orchestrator-led mode guardrails (optional)
# Max delegate_to_agent calls per user turn (default: 10)
# ORCHESTRATOR_LED_MAX_DELEGATIONS=10
# Token budget for delegated agents per user turn; 0 or unset = unlimited
# ORCHESTRATOR_LED_DELEGATION_TOKEN_BUDGET=0

# Media tool timeouts (optional)
PDF_VISION_TIMEOUT_MS=600000
PDF_PARSE_TIMEOUT_MS=120000
PDFTOPPM_TIMEOUT_MS=180000
PROCESS_MEDIA_TOOL_TIMEOUT_MS=600000

# Prevent error: 400 "Value looks like object, but can't find closing '}' symbol"
# remove it entirely to use default 51200
OLLAMA_MAX_REQUEST_BYTES=50000

# Superuser username (optional; leave empty to disable superuser features)
SUPERUSER_NAME=

# System-enabled tools (comma-separated). Only these are shown in Tools view and Configure Session → Tools.
# Empty or commented = show all tools.
# ENABLED_TOOLS=web_search,webhook_request,process_media,sqlite_local_db,local_working_folder,workspace_exec,terminal,state_persist,datetime,session_pool,ef_api,email,archived_conversation_history,conversation_rounds,session_schedule,manage_agent_documents,manage_agent_tools

# Terminal tool (Linux/macOS; needs python3 + bash, optional bubblewrap on Linux) - all optional
# auto = OS-level filesystem jail if available (bwrap / sandbox-exec), else soft jail; off = soft jail only; required = refuse without OS jail
# TERMINAL_SANDBOX=auto
# Extra paths to hide / re-allow reading inside the OS jail (comma-separated)
# TERMINAL_JAIL_HIDE_PATHS=
# TERMINAL_JAIL_ALLOW_READ=
# Idle lifetime of a session (default 30 min) and its cap (default 8 h)
# TERMINAL_IDLE_TIMEOUT_MS=1800000
# TERMINAL_MAX_IDLE_TIMEOUT_MS=28800000
# TERMINAL_MAX_SESSIONS_PER_AGENT=4
# TERMINAL_MAX_SESSIONS=24
# logs/terminal.log rotation size and per-line cap
# TERMINAL_LOG_MAX_BYTES=1048576
# TERMINAL_LOG_MAX_LINE_CHARS=300

# Telegram (optional). Each session connects its own bot token in Configure Session > Telegram.
# Minutes a QR / deep-link pairing code stays valid (default 10)
# TELEGRAM_PAIRING_TTL_MINUTES=10
# Long-poll wait per getUpdates call in seconds (default 25)
# TELEGRAM_POLL_TIMEOUT_SECONDS=25
# Override the Bot API base URL (default https://api.telegram.org)
# TELEGRAM_API_BASE=https://api.telegram.org
# Largest file accepted from Telegram, in MB (default 20 = Bot API download limit)
# TELEGRAM_MAX_DOWNLOAD_MB=20
